# --- Option A: Your merchant keys (from Pesapal onboarding email) ---
PESAPAL_ENV=live
PESAPAL_BASE_URL=https://pay.pesapal.com/v3
PESAPAL_CONSUMER_KEY="your_consumer_key_from_email"
PESAPAL_CONSUMER_SECRET="your_consumer_secret_from_email"

# --- Option B: Public sandbox demo (https://developer.pesapal.com/api3-demo-keys.txt) ---
# PESAPAL_ENV=sandbox
# PESAPAL_BASE_URL=https://cybqa.pesapal.com/pesapalv3
# PESAPAL_CONSUMER_KEY="ngW+UEcnDhltUc5fxPfrCD987xMh3Lx8"
# PESAPAL_CONSUMER_SECRET="q27RChYs5UkypdcNYKzuUw460Dg="

PESAPAL_IPN_URL=https://your-ngrok-host/api/payments/ipn/
PESAPAL_CALLBACK_URL=https://your-ngrok-host/api/payments/callback/
PESAPAL_CANCELLATION_URL=
PESAPAL_NOTIFICATION_ID=
DEFAULT_PAYMENT_PROVIDER=PESAPAL
